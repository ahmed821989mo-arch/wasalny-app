{
  "name": "wasalny-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "deploy": "npm run build && firebase deploy --only functions",
    "lint": "tsc --noEmit",
    "test:boundary": "npm run build && node --test test/boundary.test.cjs",
    "test:rules": "cd .. && firebase emulators:exec --project demo-wasalny --only firestore,storage \"npm --prefix functions run test:rules:local\"",
    "test:rules:local": "node --test test/firestore.rules.test.cjs"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "geofire-common": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "@google-cloud/pubsub": "^6.1.0",
    "@opentelemetry/core": "^2.11.0",
    "basic-ftp": "^6.2.1",
    "uuid": "^11.1.1"
  }
}
